    "A broken link is a shortcut whose target is missing. Removing the link does not uninstall another working copy of the tool." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失效链接是目标已不存在的快捷入口。移除该链接不会卸载这个工具的其他正常安装。"
          }
        }
      }
    },
    "A check failed, so nothing will run." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有检查未通过，不会执行任何操作。"
          }
        }
      }
    },
    "A curated starting point for your Mac. Choose tools by what you want to do." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
