    },
    "%@ couldn't be changed because permission was denied. CLI State never uses sudo, so check the permissions of the install location." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未能更改：权限不足。CLI State 从不使用 sudo，请检查安装位置的权限。"
          }
        }
      }
    },
    "%@ couldn't be changed because the network is unavailable. Check your connection, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络不可用，%@ 未能更改。请检查网络连接后重试。"
          }
        }
      }
    },
    "%@ couldn't be found in your shell's PATH, so its packages aren't listed." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Shell 的 PATH 中找不到 %@，因此没有列出它管理的软件包。"
