{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ removes the package and its links, then the selected leftover files are moved to the Trash." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会移除软件包及其链接，然后把选中的残留文件移到废纸篓。"
          }
        }
      }
    },
    "%@ uninstalls %@ first, then the files you select are moved to the Trash." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先由 %1$@ 卸载 %2$@，再把你勾选的文件移到废纸篓。"
          }
        }
      }
    },
