    },
    "CLI State didn't find packages you installed yourself with a supported package manager." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有找到你通过受支持的包管理器主动安装的软件包。"
          }
        }
      }
    },
    "CLI State runs the commands below, then rescans to confirm each package is installed. Packages that are already installed aren't upgraded." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLI State 会运行下面的命令，然后重新扫描，确认每个软件包都已装好。已经安装的软件包不会被升级。"
