    "AI only picks from CLI State's list of known tools. It never writes commands, and nothing is installed until you review the checklist and confirm." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 只会从 CLI State 已知的工具清单里挑选，不会编写任何命令；在你核对清单并确认之前，什么都不会安装。"
          }
        }
      }
    },
    "Already installed (%lld)" : {
